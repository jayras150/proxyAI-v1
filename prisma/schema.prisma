// ProxyAI — Prisma Schema v1
// Blueprint Reference: Sprint 8 — Database Design
// Wallet Foundation: Sprint 4 §19-26, Design Review Wallet v1 (approved)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ApiKeyStatus {
  ACTIVE
  DISABLED
  REVOKED
}

enum Currency {
  USD
  IDR
  SGD
}

enum WalletStatus {
  ACTIVE
  LOCKED
  SUSPENDED
}

enum TransactionType {
  TOPUP
  AI_USAGE
  REFUND
  ADJUSTMENT
  ADMIN_CREDIT
  ADMIN_DEBIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TopupStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentProvider {
  MOCK
  XENDIT
  STRIPE
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// ─── Core Models ────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)

  wallet    Wallet?
  apiKeys   ApiKey[]
  sessions  Session[]
  usageLogs UsageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model ApiKey {
  id         String       @id @default(uuid())
  userId     String
  name       String
  keyPrefix  String
  keyHash    String       @unique
  lastUsedAt DateTime?
  status     ApiKeyStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

// ─── Wallet Domain ──────────────────────────────────────────────────────

model Wallet {
  id       String       @id @default(uuid())
  userId   String       @unique
  balance  Decimal      @default(0) @db.Decimal(18, 6)
  currency Currency     @default(USD)
  status   WalletStatus @default(ACTIVE)
  version  Int          @default(1) // optimistic locking (future)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  topupRequests TopupRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("wallets")
}

model Transaction {
  id            String            @id @default(uuid())
  walletId      String
  userId        String // denormalized for audit (immutable)
  amount        Decimal           @db.Decimal(18, 6)
  balanceBefore Decimal           @db.Decimal(18, 6)
  balanceAfter  Decimal           @db.Decimal(18, 6)
  currency      Currency          @default(USD)
  type          TransactionType
  reference     String            @unique
  status        TransactionStatus @default(COMPLETED)
  description   String?

  // Audit metadata (Blueprint: audit & investigation)
  requestId         String?
  providerReference String?
  createdBy         String? // 'user:<id>' | 'admin:<id>' | 'system'
  ipAddress         String?
  userAgent         String?

  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  topupRequest TopupRequest?

  createdAt DateTime @default(now())

  @@index([walletId, createdAt, id]) // cursor pagination
  @@index([userId, createdAt])
  @@index([reference])
  @@map("transactions")
}

model TopupRequest {
  id                String          @id @default(uuid())
  userId            String
  walletId          String
  amount            Decimal         @db.Decimal(18, 6)
  currency          Currency        @default(USD)
  status            TopupStatus     @default(PENDING)
  provider          PaymentProvider
  providerReference String?         @unique
  transactionId     String?         @unique
  expiresAt         DateTime

  wallet      Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([walletId, status])
  @@map("topup_requests")
}

model IdempotencyKey {
  id          String            @id @default(uuid())
  key         String
  scope       String // 'wallet:topup' | 'billing:usage' | 'wallet:refund' | ...
  userId      String
  requestHash String // sha256 of canonical request body
  response    Json?
  status      IdempotencyStatus @default(PENDING)
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, scope, userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model WebhookEvent {
  id              String             @id @default(uuid())
  provider        PaymentProvider
  providerEventId String
  payloadHash     String // sha256 of raw payload
  payload         Json?
  status          WebhookEventStatus @default(RECEIVED)
  error           String?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

// ─── Usage / Audit / AI Config ──────────────────────────────────────────

model UsageLog {
  id               String  @id @default(uuid())
  userId           String
  apiKeyId         String?
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  providerCost     Decimal @db.Decimal(18, 10)
  userCost         Decimal @db.Decimal(18, 6)
  latencyMs        Int?
  status           String
  requestId        String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiModel AiModel? @relation(fields: [modelId], references: [id])

  modelId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("usage_logs")
}

model AuditLog {
  id          String  @id @default(uuid())
  adminId     String
  action      String
  resource    String
  beforeValue Json?
  afterValue  Json?
  ipAddress   String?
  userAgent   String?
  status      String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
  @@map("audit_logs")
}

model AiModel {
  id            String  @id @default(uuid())
  displayName   String
  provider      String
  modelId       String  @unique
  contextWindow Int
  inputPrice    Decimal @db.Decimal(10, 6)
  outputPrice   Decimal @db.Decimal(10, 6)
  enabled       Boolean @default(true)
  capabilities  Json?

  usageLogs UsageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_models")
}

model AiConfiguration {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("ai_configurations")
}
